# FAIM Target (required to benchmark FAIM)
FAIM_BASE_URL=http://localhost:8000
FAIM_API_KEY=
FAIM_TENANT_ID=
FAIM_BEARER_TOKEN=
FAIM_PROFILE=strict
FAIM_PERSIST_MODE=strict
FAIM_GRAPH_MAX_HOPS=2
FAIM_EMBEDDING_PROVIDER_ID=local
FAIM_EMBEDDING_MODEL_ID=ibm-granite/granite-embedding-97m-multilingual-r2
# Replace with the deterministic hash/revision used by the local model bundle.
FAIM_EMBEDDING_MODEL_REVISION=local-sha256-<model-bundle-hash>
# Isolate benchmark ingestion from autonomous jobs in the worker.
FAIM_BENCHMARK_MODE=true
FAIM_CHUNKING_ENABLED=true
FAIM_CHUNK_MAX_CHARS=1200
FAIM_CHUNK_OVERLAP=120
FAIM_PHASE5_DENSE_SQL_MAX_NODES=2000
FAIM_JOB_MAX_RETRIES=1

# Competitor API Keys (leave blank to skip cleanly)
MEM0_API_KEY=
ZEP_API_KEY=
ZEP_BASE_URL=https://api.getzep.com
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
LETTA_BASE_URL=
LETTA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional dataset cache / local overrides
FAIM_BENCH_DATA_DIR=~/.faim/bench_datasets
LOCOMO_DATA_PATH=
LONGMEMEVAL_DATA_PATH=
