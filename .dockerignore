# ==============================================
# FAIM Docker Ignore File (SECURITY HARDENED)
# These files/folders are NOT copied into Docker
# ==============================================

# Python virtual environment
.venv
venv
__pycache__
*.pyc
*.pyo
*.egg-info
.eggs
.mypy_cache
.ruff_cache
.pytest_cache

# Node modules
node_modules
.npm

# Git
.git
.gitignore
.gitattributes

# IDE/Editor
.idea
.vscode
*.swp
*.swo
.DS_Store

# Build artifacts
dist/
build/
*.log

# SECURITY: Environment files - NEVER copy to container
.env
.env.*
.env.local
.env.development
.env.production
*.env

# SECURITY: SSL certificates (mount as volume instead)
deploy/ssl
*.pem
*.key
*.crt
*.p12

# Docker files
Dockerfile*
docker-compose*

# Documentation
docs
*.md
!README.md
faim_native/Docs/

# Tests
tests
pytest.ini
.coverage
htmlcov

# SECURITY: Backup files
*.bak
*.backup
*.dump

