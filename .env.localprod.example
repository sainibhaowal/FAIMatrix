# FAIM Local Production Environment Configuration
# Example template only. Copy to root `.env.localprod` on the local-prod machine and
# replace every `CHANGE_ME_*` value before starting the stack.

FAIM_MODE=production
FAIM_ENV=production
FAIM_LOG_LEVEL=INFO

POSTGRES_PASSWORD=CHANGE_ME_LOCALPROD_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_LOCALPROD_REDIS_PASSWORD
QDRANT_API_KEY=CHANGE_ME_LOCALPROD_QDRANT_API_KEY

DATABASE_URL=postgresql://faim:CHANGE_ME_LOCALPROD_POSTGRES_PASSWORD@postgres:8020/faim_native
REDIS_URL=redis://:CHANGE_ME_LOCALPROD_REDIS_PASSWORD@redis:8030/0
QDRANT_URL=http://qdrant:8040

NEXTAUTH_URL=https://faimatrix.localhost:8443
NEXTAUTH_SECRET=CHANGE_ME_LOCALPROD_NEXTAUTH_SECRET
FAIM_MASTER_KEY=CHANGE_ME_LOCALPROD_MASTER_KEY_HEX
RESEND_API_KEY=CHANGE_ME_LOCALPROD_RESEND_API_KEY
TENANT_KEYS_JSON={"default":["CHANGE_ME_LOCALPROD_TENANT_KEY"]}
ADMIN_KEYS_JSON={"admin":"CHANGE_ME_LOCALPROD_ADMIN_KEY"}
FAIM_ADMIN_KEY=CHANGE_ME_LOCALPROD_ADMIN_KEY
FAIM_ADMIN_EMAIL=CHANGE_ME_LOCALPROD_ADMIN_EMAIL
FAIM_ADMIN_EMAILS_JSON=["CHANGE_ME_LOCALPROD_ADMIN_EMAIL"]

FAIM_PUBLIC_ORIGIN=https://faimatrix.localhost:8443
FAIM_CORS_ALLOW_ORIGINS=https://faimatrix.localhost:8443
FAIM_CSP_CONNECT_SRC=https://faimatrix.localhost:8443,https://api.resend.com

FAIM_AUTO_MIGRATE=false
FAIM_BACKUP_DIR=/var/lib/faim/backups
FAIM_RAW_STORE_PATH=/var/lib/faim/raw/blobs

FAIM_ENCRYPTION_AT_REST=true
FAIM_ENCRYPTION_FAIL_CLOSED=true
FAIM_AUTH_DB_PRIMARY=true
FAIM_AUTH_ENV_FALLBACK_ENABLED=false
FAIM_AUTH_SCOPE_ENFORCEMENT_ENABLED=true
FAIM_STORAGE_CONTRACT_STRICT=true
FAIM_STORAGE_OBSERVABILITY_ENABLED=true
FAIM_PROFILE_PERSIST_COMPAT_MODE=true

FAIM_ENABLE_CACHE=true
FAIM_ENABLE_INDEX=true
FAIM_ENABLE_JOBS=true
FAIM_OCR_ENABLED=false
FAIM_OCR_ENGINE=tesseract
FAIM_OCR_FAIL_CLOSED=true
FAIM_SELF_INVENT_ENABLED=false
FAIM_SELF_EVOLVE_ENABLED=false

FAIM_RATE_LIMITS_JSON={"ingest_per_minute":100,"query_per_minute":200,"events_per_minute":600,"storage_per_minute":120,"api_keys_per_minute":30}
