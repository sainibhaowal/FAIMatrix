# =============================================================================
# FAIM-Native Environment Configuration
# =============================================================================
# Copy to .env and fill in required values.
# NEVER commit .env to git.
#
# Port Alignment (80x0 range):
#   API:      8000
#   Frontend: 8010
#   Postgres: 8020
#   Redis:    8030
#   Qdrant:   8040 (HTTP) / 8050 (gRPC)
# =============================================================================

# -----------------------------------------------------------------------------
# MODE
# -----------------------------------------------------------------------------
FAIM_MODE=production
FAIM_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# DATABASE (REQUIRED)
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD

# -----------------------------------------------------------------------------
# REDIS (REQUIRED)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD

# -----------------------------------------------------------------------------
# VECTOR DATABASE (REQUIRED)
# -----------------------------------------------------------------------------
QDRANT_API_KEY=CHANGE_ME_GENERATE_SECURE_API_KEY

# -----------------------------------------------------------------------------
# AUTHENTICATION (REQUIRED)
# -----------------------------------------------------------------------------
# Admin API Keys (JSON dictionary)
ADMIN_KEYS_JSON={"admin": "CHANGE_ME_SECURE_KEY"}

# Tenant API Keys (JSON dictionary)
TENANT_KEYS_JSON={"default": ["CHANGE_ME_SECURE_KEY"]}

# NextAuth (for frontend sync)
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
NEXTAUTH_URL=http://localhost:8010

# -----------------------------------------------------------------------------
# MIGRATIONS
# -----------------------------------------------------------------------------
FAIM_AUTO_MIGRATE=false

# -----------------------------------------------------------------------------
# RATE LIMITS
# -----------------------------------------------------------------------------
# JSON configuration for rate limiting
FAIM_RATE_LIMITS_JSON={"ingest_per_minute": 100, "query_per_minute": 200, "events_per_minute": 600, "storage_per_minute": 120, "api_keys_per_minute": 30}

# -----------------------------------------------------------------------------
# SYSTEM
# -----------------------------------------------------------------------------
FAIM_LOCK_DIR=/tmp/faim/locks

# -----------------------------------------------------------------------------
# OCR (Phase I)
# -----------------------------------------------------------------------------
# OCR is disabled by default; enable only when runtime has tesseract installed.
FAIM_OCR_ENABLED=false
FAIM_OCR_ENGINE=tesseract
FAIM_OCR_FAIL_CLOSED=false
FAIM_OCR_LANGS=eng
FAIM_OCR_TIMEOUT_SECONDS=20
FAIM_OCR_MAX_IMAGE_PIXELS=24000000
FAIM_OCR_PDF_RENDER_DPI=180

# -----------------------------------------------------------------------------
# SELF-INVENTING (Phase J)
# -----------------------------------------------------------------------------
# Disabled by default; enable deliberately after validation.
FAIM_SELF_INVENT_ENABLED=false
FAIM_SELF_INVENT_ON_EVOLVE=true
FAIM_SELF_INVENT_AFTER_UPLOAD=false
FAIM_SELF_INVENT_MAX_MACROS_PER_CYCLE=3
FAIM_SELF_INVENT_EVENT_WINDOW=5000
FAIM_SELF_INVENT_MIN_COACTIVATION_COUNT=3
FAIM_SELF_INVENT_LAMBDA_THRESHOLD=0.3
FAIM_SELF_INVENT_MIN_REDUNDANCY_REDUCTION=0.01

# -----------------------------------------------------------------------------
# SELF-EVOLVE (Phase S1)
# -----------------------------------------------------------------------------
# S1 is contract/guardrails only. Runtime behavior stays unchanged by default.
FAIM_SELF_EVOLVE_ENABLED=false
# Allowed: manual, post_upload, periodic, hybrid
FAIM_SELF_EVOLVE_TRIGGER_MODE=manual
FAIM_SELF_EVOLVE_MIN_INTERVAL_SECONDS=300
FAIM_SELF_EVOLVE_MIN_VERSION_DELTA=1
FAIM_SELF_EVOLVE_MAX_ACTIONS=25

# -----------------------------------------------------------------------------
# AUTH ENFORCEMENT (Phase K3)
# -----------------------------------------------------------------------------
# DB-backed API key auth is primary by default.
FAIM_AUTH_DB_PRIMARY=true

# Legacy env-key fallback is disabled by default.
# Enable only for controlled compatibility windows.
FAIM_AUTH_ENV_FALLBACK_ENABLED=false

# Scope enforcement is disabled by default until route-level rollout.
FAIM_AUTH_SCOPE_ENFORCEMENT_ENABLED=false
