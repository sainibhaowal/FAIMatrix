# =============================================================================
# FAIM-Native Environment Configuration (Single Source of Truth)
# =============================================================================
# Copy to `.env` in the repository root and replace all `CHANGE_ME_*` values.
# Never commit `.env` to version control.
#
# Service Ports (default local Compose):
#   API:      8000
#   Frontend: 8010
#   Postgres: 8020
#   Redis:    8030
#   Qdrant:   8040 (HTTP) / 8050 (gRPC)
# =============================================================================

# --- Runtime Mode ---
FAIM_MODE=production
FAIM_ENV=production
FAIM_LOG_LEVEL=INFO

# --- Core Data Plane (Required) ---
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_SECURE_PASSWORD
QDRANT_API_KEY=CHANGE_ME_SECURE_API_KEY
DATABASE_URL=postgresql://faim:CHANGE_ME_SECURE_PASSWORD@postgres:8020/faim_native
REDIS_URL=redis://:CHANGE_ME_SECURE_PASSWORD@redis:8030/0
QDRANT_URL=http://qdrant:8040

# --- Authentication & Cryptography (Required) ---
NEXTAUTH_URL=http://localhost:8010
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
# 64-character hex key (openssl rand -hex 32)
FAIM_MASTER_KEY=CHANGE_ME_PROD_MASTER_KEY_HEX
RESEND_API_KEY=CHANGE_ME_SECURE_RESEND_API_KEY
# Database-primary API key auth: keep legacy plaintext maps empty.
TENANT_KEYS_JSON={}
ADMIN_KEYS_JSON={}

# --- Browser / Edge Security ---
FAIM_PUBLIC_ORIGIN=http://localhost:8010
FAIM_CORS_ALLOW_ORIGINS=http://localhost:8010
FAIM_CSP_CONNECT_SRC=http://localhost:8010,https://api.resend.com

# --- Migrations & Security Hardening ---
FAIM_AUTO_MIGRATE=false
FAIM_ENCRYPTION_AT_REST=true
FAIM_ENCRYPTION_FAIL_CLOSED=true
FAIM_AUTH_DB_PRIMARY=true
FAIM_AUTH_ENV_FALLBACK_ENABLED=false
FAIM_AUTH_SCOPE_ENFORCEMENT_ENABLED=true
FAIM_ALLOW_DEV_AUTH_BYPASS=false
FAIM_STORAGE_CONTRACT_STRICT=true
FAIM_STORAGE_OBSERVABILITY_ENABLED=true
FAIM_PROFILE_PERSIST_COMPAT_MODE=false

# --- Acceleration, Workers & GPU / CPU Hybrid ---
FAIM_ENABLE_CACHE=false
FAIM_ENABLE_INDEX=false
FAIM_ENABLE_JOBS=true
FAIM_BENCHMARK_MODE=false
FAIM_API_WORKERS=6
FAIM_INGEST_WORKERS=8
# On CPU-only hosts/VPS leave TORCH_INDEX_URL=cpu, FAIM_CONTAINER_RUNTIME=runc, NVIDIA_VISIBLE_DEVICES=void.
# On CUDA GPU hosts set TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124, FAIM_CONTAINER_RUNTIME=nvidia, NVIDIA_VISIBLE_DEVICES=all.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
FAIM_CONTAINER_RUNTIME=runc
NVIDIA_VISIBLE_DEVICES=void
FAIM_EMBEDDING_DEVICE=auto
FAIM_USE_GPU_BACKEND=auto
FAIM_MIN_CUDA_FREE_MIB=1024
FAIM_FAST_ML_EMBEDDING=false
FAIM_EMBEDDING_PREWARM=true
FAIM_EMBEDDING_PREWARM_TIMEOUT_SECONDS=300
FAIM_EMBEDDING_PREWARM_REQUIRED=true

# --- Retrieval, OCR & Self-Evolution ---
FAIM_REPR_V2_ENABLED=true
FAIM_PHASE5_ENABLED=true
FAIM_PHASE5_DENSE_SQL_MAX_NODES=2000
FAIM_FAST_RELEVANCE_FIRST=true
FAIM_FAST_GRAPH_EXPANSION=false
FAIM_FAST_IDF=false
FAIM_CHUNKING_ENABLED=false
FAIM_CHUNK_MAX_CHARS=1200
FAIM_CHUNK_OVERLAP=120
FAIM_JOB_MAX_RETRIES=1
FAIM_OCR_ENABLED=false
FAIM_OCR_ENGINE=tesseract
FAIM_OCR_FAIL_CLOSED=true
FAIM_OCR_LANGS=eng
FAIM_SELF_INVENT_ENABLED=false
FAIM_SELF_INVENT_ON_EVOLVE=true
FAIM_SELF_INVENT_AFTER_UPLOAD=false
FAIM_SELF_INVENT_MAX_MACROS_PER_CYCLE=3
FAIM_SELF_INVENT_EVENT_WINDOW=5000
FAIM_SELF_INVENT_MIN_COACTIVATION_COUNT=3
FAIM_SELF_INVENT_LAMBDA_THRESHOLD=0.3
FAIM_SELF_INVENT_MIN_REDUNDANCY_REDUCTION=0.01
FAIM_SELF_EVOLVE_ENABLED=false
FAIM_SELF_EVOLVE_TRIGGER_MODE=manual
FAIM_SELF_EVOLVE_MIN_INTERVAL_SECONDS=300
FAIM_SELF_EVOLVE_SCAN_INTERVAL_SECONDS=30
FAIM_SELF_EVOLVE_MIN_VERSION_DELTA=1
FAIM_SELF_EVOLVE_MAX_ACTIONS=25

# --- Rate Limits & Operational Directories ---
FAIM_RATE_LIMITS_JSON={"ingest_per_minute":100,"query_per_minute":200,"events_per_minute":600,"storage_per_minute":120,"api_keys_per_minute":30}
FAIM_EVENT_PAYLOAD_MAX_BYTES=4096
FAIM_EXPLAIN_MAX_ITEMS=25
FAIM_LOCK_DIR=/tmp/faim/locks
FAIM_BACKUP_DIR=/var/lib/faim/backups
FAIM_RAW_STORE_PATH=/var/lib/faim/raw/blobs

# --- Optional Remote / Reverse-Proxy Overrides (--profile vps) ---
FAIM_GATEWAY_NETWORK=faim-gateway-net
