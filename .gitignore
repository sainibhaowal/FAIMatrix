# ==============================================
# FAIM Git Ignore (SECURITY HARDENED)
# ==============================================

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# SECURITY: ALL environment files
.env
.env.*
.env.local
.env.development
.env.production
*.env

# SECURITY: SSL/TLS certificates
deploy/ssl/
*.pem
*.key
*.crt
*.p12
*.pfx

# SECURITY: Secrets and credentials
secrets/
credentials/
*.secret
service-account.json

# SECURITY: Database dumps and backups
*.sql
!faim_native/**/*.sql
*.dump
*.bak
*.backup
backup/
backups/

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Runtime
Runtime/
*.log
*.pid

# VS Code / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Local LLM models
backend/faim/llm_models/