# Docker ignore for frontend
# Exclude node_modules - npm install creates fresh ones inside Docker
node_modules

# Next.js build output
.next
out
dist
build

# Build logs
*.log
build.log
build_log.txt
build.txt
build_v4.txt

# Git
.git
.gitignore

# IDE
.idea
.vscode

# Local docs / tests / reports - not needed in the frontend image
Docs/
e2e/
tests/
playwright-report/
test-results/
*.tsbuildinfo
