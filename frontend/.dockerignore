# Docker ignore for frontend
# IMPORTANT: We're NOT excluding node_modules 
# because we want to copy them into Docker

# Next.js build output
.next
out
dist
build

# Build logs
*.log
build.log
build_log.txt
build.txt
build_v4.txt

# Git
.git
.gitignore

# Environment (secrets)
.env
.env.local
.env.*.local

# IDE
.idea
.vscode
