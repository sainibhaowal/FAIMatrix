# FAIM Frontend Environment Configuration
# Backend API URL (FAIM-Native FastAPI server)
NEXT_PUBLIC_FAIM_API_BASE_URL=http://localhost:8000

# Default graph ID for new users
NEXT_PUBLIC_FAIM_DEFAULT_GRAPH_ID=U:default-universe

# NextAuth secret (for session encryption)
NEXTAUTH_SECRET=dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Email provider (Resend) - key is in .env
# RESEND_API_KEY is loaded from .env
