# NEXTAUTH_SECRET: Generate a 32+ char random string
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
# NEXTAUTH_URL: The public URL of the frontend
NEXTAUTH_URL=http://localhost:8010
# NEXT_PUBLIC_FAIM_API_BASE_URL: Relative path for Next.js proxying
NEXT_PUBLIC_FAIM_API_BASE_URL=/api/v1
# FAIM_ADMIN_KEY: server-side admin bridge key
FAIM_ADMIN_KEY=CHANGE_ME_ADMIN_KEY
# FAIM_ADMIN_EMAILS_JSON: allowlisted admin emails for the UI
FAIM_ADMIN_EMAILS_JSON=["admin@faim-atrix.com"]
