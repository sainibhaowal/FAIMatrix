# FAIM Frontend Development Dockerfile

FROM node:20-alpine

WORKDIR /app

# Initialize Environment Schema
COPY package*.json ./

# Install dependencies (with legacy-peer-deps for eslint compatibility)
RUN npm install --legacy-peer-deps

# Direct Native Access
# All frontend assets are served natively from the source.

EXPOSE 8010

# Run Next.js on 0.0.0.0 so it's accessible from outside container
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", "8010"]

