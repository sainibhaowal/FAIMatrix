# FAIM Frontend Development Dockerfile

FROM node:20-alpine

WORKDIR /app

# Copy package files first (for better caching)
COPY package*.json ./

# Install dependencies (with legacy-peer-deps for eslint compatibility)
RUN npm install --legacy-peer-deps

# Copy everything else
COPY . .

# Expose port
EXPOSE 3000

# Run Next.js on 0.0.0.0 so it's accessible from outside container
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0"]

