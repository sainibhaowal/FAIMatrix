# FAIM Staging Environment Configuration
# Legacy example template only. The active production workflows use:
# - `.env.localprod` for local production
# - `deploy/env.vpsprod` for VPS production
# Copy to `.env.staging` only if you intentionally maintain a separate staging stack.

FAIM_MODE=staging
FAIM_LOG_LEVEL=INFO

DATABASE_URL=postgresql://faim:CHANGE_ME_STAGING_PASSWORD@postgres:8020/faim_native
REDIS_URL=redis://:CHANGE_ME_STAGING_PASSWORD@redis:8030/0
QDRANT_URL=http://qdrant:8040
QDRANT_API_KEY=CHANGE_ME_STAGING_QDRANT_KEY

NEXTAUTH_URL=https://staging.example.com
NEXTAUTH_SECRET=CHANGE_ME_STAGING_NEXTAUTH_SECRET
FAIM_MASTER_KEY=CHANGE_ME_STAGING_MASTER_KEY_HEX
RESEND_API_KEY=CHANGE_ME_STAGING_RESEND_API_KEY
TENANT_KEYS_JSON={"default":["CHANGE_ME_STAGING_TENANT_KEY"]}
ADMIN_KEYS_JSON={"admin":"CHANGE_ME_STAGING_ADMIN_KEY"}

FAIM_CORS_ALLOW_ORIGINS=https://staging.example.com
FAIM_PUBLIC_ORIGIN=https://staging.example.com
FAIM_CSP_CONNECT_SRC=https://staging.example.com,https://api.resend.com

FAIM_AUTO_MIGRATE=false
FAIM_ENCRYPTION_AT_REST=true
FAIM_ENCRYPTION_FAIL_CLOSED=true
FAIM_AUTH_DB_PRIMARY=true
FAIM_AUTH_ENV_FALLBACK_ENABLED=false
FAIM_AUTH_SCOPE_ENFORCEMENT_ENABLED=true
FAIM_STORAGE_CONTRACT_STRICT=true
FAIM_STORAGE_OBSERVABILITY_ENABLED=true
FAIM_PROFILE_PERSIST_COMPAT_MODE=false

FAIM_ENABLE_CACHE=true
FAIM_ENABLE_INDEX=true
FAIM_ENABLE_JOBS=true
FAIM_OCR_ENABLED=false
FAIM_OCR_ENGINE=tesseract
FAIM_OCR_FAIL_CLOSED=true
FAIM_SELF_INVENT_ENABLED=false
FAIM_SELF_EVOLVE_ENABLED=false
