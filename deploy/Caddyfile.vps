# TLS is terminated by the existing VPS gateway.  This proxy intentionally
# listens on plain HTTP inside the FAIM stack and is not internet-facing.
:80 {
  encode gzip zstd

  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  @backend_health path /health /ready /version
  handle @backend_health {
    reverse_proxy api:8000
  }

  handle {
    reverse_proxy frontend:8010
  }
}
