# FAIM Lab Production Environment Configuration
# Copy to .env and fill in production values

# --- Mode ---
FAIM_MODE=dev  # Options: dev, development, production, prod

# --- Database ---
FAIM_DB_URL=postgresql://faim:faim_dev_pass@localhost/faim_lab

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible storage) ---
FAIM_S3_ENDPOINT=http://localhost:9000
FAIM_S3_ACCESS_KEY=minioadmin
FAIM_S3_SECRET_KEY=minioadmin
FAIM_S3_BUCKET=faim-uploads

# --- Keycloak (OIDC) ---
KEYCLOAK_ISSUER=http://localhost:8080/realms/faim
KEYCLOAK_CLIENT_ID=faim-lab
KEYCLOAK_CLIENT_SECRET=  # Get from Keycloak admin console

# --- NextAuth (Frontend) ---
NEXTAUTH_URL=http://127.0.0.1:8010
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand

# --- Admin ---
ADMIN_API_KEY=  # Generate a secure key for admin operations

# --- Stripe (Phase 4) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=
