{
  "name": "faim-root",
  "version": "1.0.0",
  "description": "FAIM-Native Root Management",
  "scripts": {
    "faim:up": "docker compose up -d",
    "faim:update": "git pull --ff-only && docker compose build",
    "faim:down": "docker compose down",
    "faim:logs": "docker compose logs -f",
    "faim:ps": "docker compose ps",
    "faim:accel:up": "docker compose --profile accel up -d",
    "faim:vps:sync": "./scripts/vps_sync.sh",
    "faim:vps:up": "./scripts/vps_up.sh",
    "faim:vps:down": "./scripts/vps_down.sh",
    "faim:vps:smoke": "./scripts/vps_smoke.sh",
    "faim:vps:backup": "./scripts/vps_backup.sh",
    "faim:vps:restore": "./scripts/vps_restore.sh",
    "faim:cleanup": "docker system prune -f",
    "tsc": "cd frontend && npm run typecheck",
    "eslint": "cd frontend && npm run lint",
    "prettier": "cd frontend && npm run format:check"
  }
}
